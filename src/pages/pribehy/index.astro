---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/travel/StoryCard.astro';
import { getCollection } from 'astro:content';

const allStories = await getCollection('stories', ({ data }) => !data.draft);
const sorted = allStories.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['cesta', 'pruvodce', 'technika', 'zamysleni', 'aktualita', 'nova-vyprava'] as const;
const categoryLabels: Record<string, string> = {
  cesta: 'Cesta', pruvodce: 'Průvodce', technika: 'Technika', zamysleni: 'Zamyšlení',
  aktualita: 'Aktuality', 'nova-vyprava': 'Nové výpravy',
};

// Filtrování běží na klientu (web je statický — query parametry se při buildu
// nevyhodnotí, takže server-side filtr by vždy vrátil „Vše").
---

<BaseLayout
  title="Příběhy z cest"
  description="Všechny reportáže a zápisky z cesty kolem světa Teslou — od startu v Barceloně přes Maroko, USA a Čínu až po návrat domů. Řazeno od nejnovějšího."
>
  <div class="page-wrap">
    <div class="container">
      <div class="page-header" data-reveal>
        <h1>Příběhy z cest</h1>
        <p class="page-lead">Reportáže, zápisky a průvodci přímo z asfaltu.</p>
      </div>

      <!-- Filter tabs -->
      <div class="filter-tabs" aria-label="Filtr kategorií">
        <button type="button" class="filter-tab active" data-filter="vse" aria-pressed="true"
        >Vše ({sorted.length})</button>
        {categories.map(cat => {
          const count = sorted.filter(s => s.data.category === cat).length;
          if (count === 0) return null;
          return (
            <button type="button" class="filter-tab" data-filter={cat} aria-pressed="false"
            >{categoryLabels[cat]} ({count})</button>
          );
        })}
      </div>

      <div class="grid-3" id="stories-grid">{sorted.map(story => <StoryCard story={story} headingLevel={2} />)}</div>
      <p class="empty" id="stories-empty" hidden>Žádné příběhy v této kategorii.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-wrap { padding-top: calc(72px + 3rem); padding-bottom: 5rem; }
  .page-header { margin-bottom: 2rem; }
  .page-lead { font-size: 1.1rem; color: var(--text-muted); margin-top: 0.5rem; }

  .filter-tabs {
    display: flex; gap: 0.5rem; flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .filter-tab {
    font-family: var(--font-sans); font-size: 0.85rem; font-weight: 500;
    padding: 0.4rem 1rem; border-radius: 100px;
    border: 1.5px solid var(--border-strong);
    background: none; cursor: pointer;
    color: var(--text-muted); text-decoration: none;
    transition: all var(--duration) var(--ease);
  }
  .filter-tab:hover { border-color: var(--accent-text); color: var(--accent-text); }
  .filter-tab.active {
    background: var(--accent-text); border-color: var(--accent-text);
    color: #fff;
  }
  .empty { color: var(--text-muted); padding: 3rem 0; }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('#stories-grid > *');
  const empty = document.getElementById('stories-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const filter = tab.dataset.filter ?? 'vse';
      tabs.forEach(t => {
        const on = t === tab;
        t.classList.toggle('active', on);
        t.setAttribute('aria-pressed', String(on));
      });
      let shown = 0;
      cards.forEach(card => {
        const match = filter === 'vse' || card.dataset.category === filter;
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
